{
  "plugins": ["unicorn"],
  "jsPlugins": ["@trogonstack/oxlint-plugin"],
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
        "ignore": ["^\\[{1,2}(\\.\\.\\.)?[A-Za-z0-9_-]+\\]{1,2}\\."]
      }
    ],
    "trogonstack/require-kebab-case-directories": "error"
  }
}
